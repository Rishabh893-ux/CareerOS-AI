# Server
PORT=5001
NODE_ENV=development

# Frontend URL - used to build links sent in emails (e.g. password reset).
# Point this at your local Next.js dev server for local testing; set it to
# your deployed frontend URL in production.
FRONTEND_URL=http://localhost:3001

# MongoDB Atlas (free tier)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/careeros

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Groq API - get key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# GitHub API (create a personal access token, no special scopes needed for public repo reads)
GITHUB_TOKEN=your_github_personal_access_token

# Cloudinary (free tier) - for resume file storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Quota guardrails
AI_DAILY_LIMIT=1400
AI_CACHE_TTL_HOURS=24

# Adzuna Job Search API (optional, free tier) - https://developer.adzuna.com/
# If not set, the app serves realistic mock job listings instead.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key
