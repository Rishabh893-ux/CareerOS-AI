# Server
PORT=5001
# Use "development" only locally: it shows password-reset links in the API
# response when no email provider is set. Use "production" (or leave unset) when deployed.
NODE_ENV=development

# Frontend URL - used to build links sent in emails (e.g. password reset).
# Point this at your local Next.js dev server for local testing; set it to
# your deployed frontend URL in production.
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas (free tier)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/careeros

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Groq API - get key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# GitHub API (optional) - raises the rate limit from 60 to 5,000 requests/hour.
# A personal access token with no scopes is enough for public repo reads.
GITHUB_TOKEN=your_github_personal_access_token

# Cloudinary (free tier) - for resume file storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Quota guardrails
AI_DAILY_LIMIT=1400
AI_CACHE_TTL_HOURS=24
AI_USER_RATE_LIMIT=10
AI_GLOBAL_RATE_LIMIT=30

# Adzuna Job Search API (optional, free tier) - https://developer.adzuna.com/
# If not set, search returns sample listings, clearly labelled as samples in the UI.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key

# Email (optional) - sends password-reset links. Set ONE of these:
#
# 1. Brevo (https://www.brevo.com, free 300/day) - sends over HTTPS, so it works
#    on hosts that block SMTP ports (e.g. Render's free plan). EMAIL_FROM must
#    be a sender you've verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
#
# 2. Gmail SMTP - for your own machine or a host that allows outgoing SMTP.
#    Use a Gmail app password, not your account password.
SMTP_EMAIL=
SMTP_PASSWORD=
#
# With neither set, the reset link is shown on screen only when
# NODE_ENV=development; elsewhere no link is given out.
