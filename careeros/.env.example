# Server
PORT=5001
NODE_ENV=development

# Frontend URL - used to build links sent in emails (e.g. password reset).
# Point this at your local Next.js dev server for local testing; set it to
# your deployed frontend URL in production.
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas (free tier)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/careeros

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Groq API - get key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# GitHub API (optional) - raises the rate limit from 60 to 5,000 requests/hour.
# A personal access token with no scopes is enough for public repo reads.
GITHUB_TOKEN=your_github_personal_access_token

# Cloudinary (free tier) - for resume file storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Quota guardrails
AI_DAILY_LIMIT=1400
AI_CACHE_TTL_HOURS=24

# Adzuna Job Search API (optional, free tier) - https://developer.adzuna.com/
# If not set, search returns sample listings, clearly labelled as samples in the UI.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key

# Email (optional) - sends password-reset links through Gmail. Use a Gmail
# app password, not your account password. If not set, the reset link is only
# logged to the server console.
SMTP_EMAIL=your_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
