# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (free tier)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/careeros

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Gemini API (free tier) - get key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# GitHub API (create a personal access token, no special scopes needed for public repo reads)
GITHUB_TOKEN=your_github_token_here

# Cloudinary (free tier) - for resume file storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Quota guardrails
GEMINI_DAILY_LIMIT=1400
GEMINI_CACHE_TTL_HOURS=24

# Adzuna Job Search API (optional, free tier) - https://developer.adzuna.com/
# If not set, the app serves realistic mock job listings instead.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key
